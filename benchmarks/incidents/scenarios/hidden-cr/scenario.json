          "(?:carriage[ -]?return|CRLF|hidden(?:[ -]?(?:byte|character)|\\s+CR)|\\\\r)[\\s\\S]{0,40}?\\b(?:is\\s+)?(?:in|inside|on|attached\\s+to|appended\\s+to|part\\s+of)[\\s\\S]{0,40}?(?:the\\s+)?(?:UPSTREAM_HOST(?:\\s+(?:value|setting))?|middleware\\.env)"
