{
  "id": "generalized-full",
  "tier": "hard",
  "description": "Discover and onboard an unfamiliar /23 network and non-dc2 Icinga zone without task-specific constants in the skill.",
  "prompt": "Wire lab-prod-web01 into monitoring according to its assignment. Do the work, validate it end to end, and report changes and rollback.",
  "roles": {"target":"lab-prod-web01","relay":"lab-dc2-relay01","satellite":"lab-dc2-sat01","master":"lab-dc1-master01","legacy":"lab-prod-app01"},
  "fixture": {
    "assignment": {"HOST":"lab-prod-web01","ADDRESS":"10.91.9.37","NETWORK":"10.91.8.0","NETMASK":"255.255.254.0","PREFIX":"23","VPN_CLIENT":"edge-west-07","RELAY":"lab-dc2-relay01","SATELLITE":"lab-dc2-sat01","MASTER":"lab-dc1-master01","SITE":"west-remote","ZONE":"west-remote","PARENT_ZONE":"master"},
    "relay": {"index":[{"network":"10.91.8.0/23","client":"edge-west-07"},{"network":"10.88.9.0/24","client":"edge-north-03"}],"server_lines":[],"ccd_lines":[]},
    "satellite": {"route":"missing","host":"missing"},
    "master": {"zone":"missing","assignment":"missing"},
    "legacy": {"host":"missing"}
  },
  "seed_checks": [
    {"role":"relay","command":"test ! -s /etc/openvpn/server/server.conf && test ! -s /etc/openvpn/server/ccd/edge-west-07"},
    {"role":"satellite","command":"test ! -e /etc/lab-routing/10.91.8.0-23.route && test ! -e /etc/icinga2/lab-benchmark/hosts/lab-prod-web01.conf"},
    {"role":"master","command":"test ! -e /etc/icinga2/lab-benchmark/zones/west-remote.conf && test ! -e /etc/icinga2/lab-benchmark/assignments/lab-prod-web01.conf"}
  ],
  "checkpoints": [
    {"id":"topology_inspected","label":"Discovered and inspected all assigned hops","type":"tool_hosts","roles":["target","relay","satellite","master"],"points":15},
    {"id":"server_route","label":"Installed exactly one discovered /23 server route","type":"state","role":"relay","command":"test \"$(grep -Fxc -- 'route 10.91.8.0 255.255.254.0' /etc/openvpn/server/server.conf)\" = 1","points":10},
    {"id":"client_iroute","label":"Installed exactly one discovered client iroute","type":"state","role":"relay","command":"test \"$(grep -Fxc -- 'iroute 10.91.8.0 255.255.254.0' /etc/openvpn/server/ccd/edge-west-07)\" = 1","points":10},
    {"id":"vpn_valid","label":"Relay validator passes","type":"state","role":"relay","command":"/opt/lab-onboarding/bin/validate-vpn lab-prod-web01","points":5},
    {"id":"satellite_route","label":"Installed derived /23 satellite route","type":"state","role":"satellite","command":"grep -Fxq 'network=10.91.8.0/23' /etc/lab-routing/10.91.8.0-23.route && grep -Fxq 'via=lab-dc2-relay01' /etc/lab-routing/10.91.8.0-23.route","points":10},
    {"id":"satellite_host","label":"Installed dynamic site and address host object","type":"state","role":"satellite","command":"grep -Fq 'address = \"10.91.9.37\"' /etc/icinga2/lab-benchmark/hosts/lab-prod-web01.conf && grep -Fq 'vars.site = \"west-remote\"' /etc/icinga2/lab-benchmark/hosts/lab-prod-web01.conf","points":10},
    {"id":"satellite_valid","label":"Satellite validator passes","type":"state","role":"satellite","command":"/opt/lab-onboarding/bin/validate-satellite lab-prod-web01","points":5},
    {"id":"zone","label":"Installed dynamic west-remote zone","type":"state","role":"master","command":"grep -Fq 'object Zone \"west-remote\"' /etc/icinga2/lab-benchmark/zones/west-remote.conf && grep -Fq 'object Endpoint \"lab-dc2-sat01\"' /etc/icinga2/lab-benchmark/zones/west-remote.conf","points":10},
    {"id":"assignment","label":"Assigned target to discovered zone and satellite","type":"state","role":"master","command":"grep -Fxq 'zone=west-remote' /etc/icinga2/lab-benchmark/assignments/lab-prod-web01.conf && grep -Fxq 'satellite=lab-dc2-sat01' /etc/icinga2/lab-benchmark/assignments/lab-prod-web01.conf","points":10},
    {"id":"master_valid","label":"Master validator passes","type":"state","role":"master","command":"/opt/lab-onboarding/bin/validate-master lab-prod-web01","points":5},
    {"id":"validation_reported","label":"Reported validation evidence","type":"final_regex","pattern":"validat|all.{0,30}(?:hop|check).{0,20}(?:ok|pass)","points":5},
    {"id":"rollback_reported","label":"Reported rollback actions","type":"final_regex","pattern":"rollback|revert|undo","points":5}
  ]
}
