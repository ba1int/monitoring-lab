{
  "id": "wrong-satellite",
  "description": "Move a host from a stale dc1 satellite assignment to its correct dc2 satellite without disturbing VPN state.",
  "prompt": "Reconcile the incorrect Icinga topology for lab-prod-app02. Diagnose across the target, VPN relay, satellites, and master; perform the repair; validate every hop; and report changes plus rollback.",
  "roles": {"target":"lab-prod-app02","relay":"lab-dc2-relay01","satellite":"lab-dc2-sat01","master":"lab-dc1-master01","legacy":"lab-prod-app01"},
  "checkpoints": [
    {"id":"topology_inspected","label":"Inspected target, relay, both satellites, and master","type":"tool_hosts","roles":["target","relay","satellite","master","legacy"],"points":10},
    {"id":"master_assignment","label":"Corrected master satellite assignment","type":"state","role":"master","command":"grep -Fxq 'satellite=lab-dc2-sat01' /etc/icinga2/lab-benchmark/assignments/lab-prod-app02.conf","points":20},
    {"id":"correct_satellite","label":"Created host object on assigned satellite","type":"state","role":"satellite","command":"/opt/lab-onboarding/bin/validate-satellite lab-prod-app02","points":15},
    {"id":"legacy_removed","label":"Removed only the obsolete host object","type":"state","role":"legacy","command":"test ! -e /etc/icinga2/lab-benchmark/hosts/lab-prod-app02.conf","points":15},
    {"id":"master_valid","label":"Master validator passes","type":"state","role":"master","command":"/opt/lab-onboarding/bin/validate-master lab-prod-app02","points":10},
    {"id":"vpn_preserved","label":"VPN configuration remains valid","type":"state","role":"relay","command":"/opt/lab-onboarding/bin/validate-vpn lab-prod-app02","points":5},
    {"id":"zone_preserved","label":"Preserved correct dc2 zone","type":"state","role":"master","command":"grep -Fq 'object Endpoint \"lab-dc2-sat01\"' /etc/icinga2/lab-benchmark/zones/dc2.conf && grep -Fq 'parent = \"master\"' /etc/icinga2/lab-benchmark/zones/dc2.conf","points":5},
    {"id":"cause_identified","label":"Identified stale or wrong satellite assignment","type":"final_regex","pattern":"(?:wrong|stale|incorrect|legacy).{0,60}(?:satellite|assignment)|assigned.{0,80}(?:legacy|lab-prod-app01)","points":10},
    {"id":"validation_reported","label":"Reported validation evidence","type":"final_regex","pattern":"validat|check.*(pass|ok)|all.*hop","points":5},
    {"id":"rollback_reported","label":"Reported rollback actions","type":"final_regex","pattern":"rollback|revert|undo","points":5}
  ]
}
