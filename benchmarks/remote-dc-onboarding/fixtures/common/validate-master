#!/usr/bin/env bash
set -Eeuo pipefail
source /opt/lab-onboarding/expected.env
[[ "${1:-}" == "$HOST" ]]
zone_file=/etc/icinga2/lab-benchmark/zones/dc2.conf
assignment_file="/etc/icinga2/lab-benchmark/assignments/${HOST}.conf"
diff -u <(cat <<EOF
object Endpoint "$SATELLITE" {}
object Zone "dc2" {
  endpoints = [ "$SATELLITE" ]
  parent = "master"
}
EOF
) "$zone_file"
diff -u <(printf 'host=%s\nzone=dc2\nsatellite=%s\n' "$HOST" "$SATELLITE") "$assignment_file"
printf 'master validation: ok (%s -> %s)\n' "$HOST" "$SATELLITE"
