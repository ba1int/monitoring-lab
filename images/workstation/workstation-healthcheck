#!/usr/bin/env bash

set -euo pipefail

test "$SHELL" = /bin/bash
test "$(uname -s)" = Linux
test -s "$HOME/.local/state/monitoring-lab/workstation-ready"
test -r "$HOME/.ssh/config"
test -r "$HOME/.config/nvim/init.vim"
test -r "$HOME/.config/zellij/config.kdl"
command -v bash ssh nvim zellij fzf rg bat >/dev/null
